generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CS_EXECUTIVE
  CS_LEAD
}

enum ClientIdentityKind {
  ADDRESS
  DOMAIN
}

enum OrderStatus {
  DRAFT
  ACKNOWLEDGED
  AWAITING_ETA
  ETA_SENT
  IN_PRODUCTION
  CLOSED
  CANCELLED
}

enum OrderBatchKind {
  INITIAL
  ADDITIONAL
  SAMPLE
  CORRECTION
}

enum OrderBatchStatus {
  PENDING
  DOWNLOADING
  STAGED
  WRITTEN_BACKUP
  COPIED_PRODUCTION
  VERIFIED
  FAILED
  CANCELLED
}

enum SourceLinkKind {
  DROPBOX
  GDRIVE
  ATTACHMENT
  MANUAL_DROP
  OTHER
}

enum TransferJobKind {
  DOWNLOAD
  STAGE_VERIFY
  WRITE_BACKUP
  COPY_PRODUCTION
  VERIFY_PRODUCTION
}

enum TransferJobStatus {
  QUEUED
  LEASED
  SUCCEEDED
  FAILED
}

enum TransferErrorClass {
  TRANSIENT
  PERMANENT
}

enum FileArtifactStage {
  STAGED
  BACKUP
  PRODUCTION
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  loginId      String   @unique
  email        String?  @unique
  displayName  String
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  sessions    Session[]
  auditEvents AuditEvent[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  occurredAt    DateTime @default(now()) @db.Timestamptz(6)
  correlationId String   @db.Uuid
  actorUserId   String?  @db.Uuid
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorLabel    String
  action        String
  entityType    String
  entityId      String
  metadata      Json     @default("{}")

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([correlationId])
}

model Client {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  displayName String
  folderName  String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  identities ClientIdentity[]
  orders     Order[]
}

model ClientIdentity {
  id       String             @id @default(uuid()) @db.Uuid
  clientId String             @db.Uuid
  client   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind     ClientIdentityKind
  value    String

  @@unique([kind, value])
  @@index([clientId])
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  code           String      @unique
  clientId       String      @db.Uuid
  client         Client      @relation(fields: [clientId], references: [id])
  title          String
  orderType      String
  quantity       Int?
  status         OrderStatus @default(DRAFT)
  eta            DateTime?   @db.Timestamptz(6)
  etaNote        String?
  gmailThreadId  String?     @unique
  folderName     String
  backupPath     String
  productionPath String
  cancelReason   String?
  createdById    String      @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  batches OrderBatch[]
  events  OrderEvent[]

  @@index([status])
  @@index([clientId, createdAt])
}

model OrderBatch {
  id                       String           @id @default(uuid()) @db.Uuid
  orderId                  String           @db.Uuid
  order                    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence                 Int
  kind                     OrderBatchKind
  status                   OrderBatchStatus @default(PENDING)
  subfolder                String
  notes                    String?
  failureReason            String?
  manualDropConfirmedAt    DateTime?        @db.Timestamptz(6)
  manualDropConfirmedById  String?          @db.Uuid
  createdById              String           @db.Uuid
  createdAt                DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(6)

  sourceLinks SourceLink[]
  transferJobs TransferJob[]
  fileArtifacts FileArtifact[]

  @@unique([orderId, sequence])
  @@index([status])
}

model SourceLink {
  id        String         @id @default(uuid()) @db.Uuid
  batchId   String         @db.Uuid
  batch     OrderBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  kind      SourceLinkKind
  url       String?
  localHint String?
  addedById String         @db.Uuid
  createdAt DateTime       @default(now()) @db.Timestamptz(6)

  @@index([batchId])
}

model OrderEvent {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @db.Uuid
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batchId       String?  @db.Uuid
  type          String
  payload       Json     @default("{}")
  actorUserId   String?  @db.Uuid
  actorLabel    String
  correlationId String   @db.Uuid
  occurredAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([orderId, occurredAt])
}

model TransferJob {
  id             String             @id @default(uuid()) @db.Uuid
  batchId        String             @db.Uuid
  batch          OrderBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  kind           TransferJobKind
  status         TransferJobStatus  @default(QUEUED)
  attempts       Int                @default(0)
  maxAttempts    Int                @default(3)
  leaseOwner     String?
  leaseExpiresAt DateTime?          @db.Timestamptz(6)
  lastError      String?
  errorClass     TransferErrorClass?
  bytesTotal     BigInt             @default(0)
  bytesDone      BigInt             @default(0)
  correlationId  String             @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)

  @@unique([batchId, kind])
  @@index([status, leaseExpiresAt, createdAt])
}

model FileArtifact {
  id           String            @id @default(uuid()) @db.Uuid
  batchId      String            @db.Uuid
  batch        OrderBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  relativePath String
  sizeBytes    BigInt
  sha256       String
  stage        FileArtifactStage
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([batchId, stage, relativePath])
  @@index([batchId, stage])
}
